# ========================================================
# PRIME STL — Template de Variáveis de Ambiente
# ========================================================

# 1. URL base da aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. Mercado Pago (Opcional - Deixe vazio para Modo Demonstração)
MP_ACCESS_TOKEN=TEST-seu-token-aqui

# 3. Chaves do Supabase (Opcional - Deixe vazio para Modo Demonstração)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta

# 4. Segredo para criptografia de sessões HMAC-SHA256
SESSION_SECRET=coloque-uma-chave-longa-e-aleatoria-aqui

